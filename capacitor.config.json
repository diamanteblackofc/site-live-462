{
  "appId": "br.diamantepink.terminaldiamanteblac",
  "appName": "Terminal-DiamanteBlack",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#00ffff",
      "showSpinner": false,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#00ff00",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#00ffff"
    }
  }
}